<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_login_gradient"
    android:orientation="vertical"
    android:padding="28dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Step 1 of 3"
        android:textSize="12sp"
        android:textColor="#CCC3E8"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="What should we call you?"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="32dp" />

    <EditText
        android:id="@+id/firstNameInput"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/input_field_bg"
        android:hint="First name"
        android:textColor="#FFFFFF"
        android:textColorHint="#CCC3E8"
        android:inputType="textPersonName"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:layout_marginBottom="12dp" />

    <EditText
        android:id="@+id/lastNameInput"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/input_field_bg"
        android:hint="Last name"
        android:textColor="#FFFFFF"
        android:textColorHint="#CCC3E8"
        android:inputType="textPersonName"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Date of birth"
        android:textSize="13sp"
        android:textColor="#E8E0FF"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/dobPickerButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/input_field_bg"
        android:text="Select your date of birth"
        android:textColor="#CCC3E8"
        android:textAllCaps="false"
        android:gravity="start|center_vertical"
        android:paddingStart="18dp"
        android:layout_marginBottom="32dp" />

    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <Button
        android:id="@+id/nextButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/btn_primary"
        android:text="Continue"
        android:textColor="#2D2640"
        android:textStyle="bold"
        android:textAllCaps="false" />

</LinearLayout>