<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F5F2">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header background -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:background="@drawable/bg_login_gradient"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="20dp">

            <!-- Back button -->
            <TextView
                android:id="@+id/backButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="← Back"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:layout_gravity="start"
                android:layout_marginBottom="12dp" />

            <!-- Profile photo -->
            <ImageView
                android:id="@+id/profilePhoto"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:background="@drawable/input_field_bg"
                android:scaleType="centerCrop"
                android:contentDescription="Profile photo" />

            <TextView
                android:id="@+id/profilePhotoPlaceholder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👤"
                android:textSize="36sp"
                android:layout_marginTop="-64dp"
                android:layout_gravity="center" />

        </LinearLayout>

        <!-- Name + age -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="20dp"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/profileName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Name"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#2D2640"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/profileAge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Age"
                android:textSize="14sp"
                android:textColor="#666666"
                android:layout_marginBottom="12dp" />

            <!-- Trust score -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#FFF0EB"
                android:padding="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⭐ Trust Score: "
                    android:textSize="13sp"
                    android:textColor="#FF7E5F" />

                <TextView
                    android:id="@+id/trustScore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="New member"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#FF7E5F" />

            </LinearLayout>

        </LinearLayout>

        <!-- Interests -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="20dp"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Interests"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#2D2640"
                android:layout_marginBottom="12dp" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/interestsChipGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:chipSpacingHorizontal="8dp"
                app:chipSpacingVertical="8dp" />

        </LinearLayout>

        <!-- Hangouts posted -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="20dp"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Recent Hangouts"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#2D2640"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/hangoutsPosted"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Loading..."
                android:textSize="14sp"
                android:textColor="#666666" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>